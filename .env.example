# PostgreSQL connection string used for workout records and WebRTC signaling.
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Optional TURN fallback for carrier/corporate networks that block direct WebRTC.
# Get credentials from a TURN provider and add the same variables in Vercel.
NEXT_PUBLIC_TURN_URL=turn:your-turn-host.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=temporary_username
NEXT_PUBLIC_TURN_CREDENTIAL=temporary_credential
